SENTINEL_DATABASE_URL=postgresql://api_sentinel:api_sentinel@postgres:5432/api_sentinel
SENTINEL_AUTO_CREATE_SCHEMA=false
SENTINEL_AUTH_REQUIRED=true
SENTINEL_AUTH_REQUIRE_VERIFIED_JWT=true
SENTINEL_AUTH_ENFORCE_MAPPED_ROLES=true
SENTINEL_AUTH_ALLOW_INSECURE_DEV_TOKENS=false
SENTINEL_AUTH_ALLOWED_ROLES=admin,analyst,approver,auditor
SENTINEL_AUTH_ROLE_ALIASES_JSON={"sentinel-admin":"admin","sentinel-analyst":"analyst","sentinel-approver":"approver","sentinel-auditor":"auditor"}
SENTINEL_AUTH_JWT_ALGORITHMS=RS256
SENTINEL_AUTH_JWKS_URL=http://keycloak:8080/realms/api-sentinel/protocol/openid-connect/certs
SENTINEL_DEFAULT_TENANT_CODE=default-bank
SENTINEL_DEFAULT_TENANT_NAME=Default Bank
SENTINEL_KONG_ADMIN_URL=http://kong:8001
SENTINEL_OLLAMA_BASE_URL=http://ollama:11434
SENTINEL_CONNECTOR_SIMULATED_FALLBACK=true
SENTINEL_KEYCLOAK_ISSUER=http://keycloak:8080/realms/api-sentinel
SENTINEL_KEYCLOAK_AUDIENCE=api-sentinel
